      "name": "Webhook /start-meeting",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json;\nconst required = ['meeting_id', 'teacher_id', 'student_id', 'participants'];\nconst missing = required.filter(k => !b[k]);\nif (missing.length) {\n  return [{ json: { valid: false, missing } }];\n}\nreturn [{ json: { valid: true, ...b, status: 'in_progress', started_at: new Date().toISOString() } }];"
      },
      "id": "5rkocfpr4b1v8fec",
      "name": "Validar payload",
