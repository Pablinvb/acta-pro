      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        260,
        180
      ],
      "notes": "Placeholder: SELECT * FROM meetings WHERE status='scheduled' AND start_time BETWEEN now() AND now()+interval '35 minutes'."
    },
    {
      "parameters": {
        "jsCode": "// Ajustar cuando el nodo de consulta real este conectado.\n// Se espera que cada item tenga start_time (ISO) y ya no haya sido notificado.\nconst now = new Date();\nreturn items.filter(item => {\n  if (!item.json.start_time) return false;\n  const start = new Date(item.json.start_time);\n  const minutesUntil = (start - now) / 60000;\n  return minutesUntil > 25 && minutesUntil <= 35 && !item.json.reminder_sent;\n});"
      },
