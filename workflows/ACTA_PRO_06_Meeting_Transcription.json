    },
    {
      "parameters": {
        "jsCode": "const meta = $('Extraer metadatos del fragmento').item.json;\nconst sttResult = items[0].json;\nreturn [{ json: {\n  meeting_id: meta.meeting_id,\n  timestamp: meta.chunk_timestamp,\n  text: sttResult.text || '',\n  confidence_score: sttResult.confidence ?? null,\n  expected_participants: meta.expected_participants,\n}}];"
      },
