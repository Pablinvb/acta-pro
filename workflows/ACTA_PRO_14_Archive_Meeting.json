      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = items[0].json;\nconst year = (j.meeting_date || '').slice(0,4) || new Date().getFullYear();\nconst staticData = $getWorkflowStaticData('global');\nstaticData.sequences = staticData.sequences || {};\nconst key = `${year}-${j.student_name}`;\nstaticData.sequences[key] = (staticData.sequences[key] || 0) + 1;\nconst seq = String(staticData.sequences[key]).padStart(3, '0');\nconst code = `ACTA-${year}-${(j.student_name||'').toUpperCase().replace(/\\s+/g,'')}-${seq}`;\nreturn [{ json: { ...j, acta_code: code, folder_path: `ACTA PRO/Docentes/${j.teacher_name}/${j.student_name}/${year}/${j.meeting_date} - ${j.meeting_type}` } }];"
      },
      "id": "7m5nwribqthgqcsv",
