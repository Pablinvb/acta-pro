# ─────────────────────────────────────────────────────────────────────────────
# ACTA PRO — configuración
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y NUNCA debe subirse al repositorio.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: nada de esto llega al
# navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sesión ───────────────────────────────────────────────────────────────────

# Clave con la que se firma la cookie de sesión. Mínimo 32 caracteres.
#
# OBLIGATORIA en producción, y conviene ponerla también en desarrollo: sin ella
# se usa un secreto que está escrito en el código fuente, y el repositorio es
# público, así que cualquiera podría fabricarse una sesión válida.
#
# Cambiarla cierra todas las sesiones abiertas.
#   openssl rand -base64 48
AUTH_SECRET=

# No hay contraseña compartida. Cada docente tiene la suya, guardada como huella
# PBKDF2 en la tabla `teachers`, y sólo alcanza sus propias reuniones:
#   npm --prefix web run usuarios -- alta T-045 "Ana Pérez" correo@colegio.edu.ec
#   npm --prefix web run usuarios -- clave T-045

# ── Modo de ejecución ────────────────────────────────────────────────────────

# demo : no se llama a ningún servicio externo. La app funciona entera con los
#        datos de docs/DATOS_DE_PRUEBA.md.
# live : se usan Google, OpenAI y Runachay de verdad.
ACTA_PRO_MODE=demo

# memory   : el estado vive en el proceso y se pierde al reiniciar.
# postgres : persistencia real. Crea la base con db/schema.sql.
ACTA_PRO_PERSISTENCE=memory

# Solo con ACTA_PRO_PERSISTENCE=postgres.
#   psql "$DATABASE_URL" -f web/db/schema.sql
DATABASE_URL=
# Pon `false` solo en desarrollo local sin TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Tiempo máximo para cualquier integración externa, en milisegundos.
EXTERNAL_TIMEOUT_MS=15000

# ── Transcripción ────────────────────────────────────────────────────────────
# Whisper de OpenAI. Transcribe muy bien español; medido contra una grabación
# real, acierta «Runachay» donde otros escriben «Sorronachai».
#
# No separa voces: de eso se encarga pyannote, y el motor de alineación cruza
# ambas para saber quién dijo qué.

TRANSCRIPTION_PROVIDER=openai

# ── Separación de voces (pyannoteAI) ─────────────────────────────────────────
# Responde «quién habló y cuándo». Se combina con Whisper —que responde «qué se
# dijo y cuándo»— y el motor de alineación cruza ambas para saber quién dijo qué.
#
# Sin esta clave la aplicación sigue funcionando: se transcribe igual y la
# docente atribuye las intervenciones a mano al cerrar la reunión.
#
# Lo que devuelve NO es dato biométrico: son etiquetas anónimas válidas solo
# dentro de una grabación, que no identifican a nadie ni permiten reconocer a
# esa persona en otra reunión.

PYANNOTE_API_KEY=


# ── OpenAI ───────────────────────────────────────────────────────────────────
# Análisis de la reunión, revisión de lenguaje y depuración de la transcripción.
# OPENAI_TRANSCRIPTION_MODEL solo se usa si TRANSCRIPTION_PROVIDER=openai.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ── Identidad institucional del acta ─────────────────────────────────────────
# El PDF reproduce el formulario «FORMATO ACTA REUNIÓN» del centro. Un acta con
# formato propio obligaría a la docente a copiarla al bueno a mano, y ACTA PRO
# dejaría de ahorrarle trabajo.

ACTA_PRO_INSTITUCION=UNIDAD EDUCATIVA EIGHT ACADEMY

# Lugar por defecto cuando la reunión no lo trae. Vacío a propósito: el
# formulario en papel tiene esa casilla en blanco, y es preferible una casilla
# vacía a un lugar inventado en un documento que afirma dónde ocurrió algo.
ACTA_PRO_LUGAR=

# Zona horaria con la que se imprime la hora de las firmas. Un acta ecuatoriana
# con la hora en UTC obliga a restar cinco horas para saber si la reunión fue
# por la mañana o por la tarde, y eso importa si alguien discute cuándo se firmó.
ACTA_PRO_ZONA_HORARIA=America/Guayaquil

# ── Sellado de tiempo RFC 3161 ───────────────────────────────────────────────
# El sello propio de ACTA PRO (SHA-256) demuestra que el acta no se ha tocado
# desde que se firmó. Éste demuestra CUÁNDO se firmó, y lo dice un tercero en
# lugar del servidor del propio centro. Es la diferencia entre «este documento
# es íntegro» y «este documento existía el 20 de agosto».
#
# Por defecto va a FreeTSA: pública, gratuita y sin cuenta, así funciona desde
# el primer día. PARA VALOR LEGAL EN ECUADOR hay que apuntarlo a una entidad de
# certificación acreditada (Banco Central del Ecuador, Security Data, ANF).
#
# Vacío desactiva el sellado externo: el acta se firma igual, sólo con el sello
# propio, y queda constancia en la auditoría.
ACTA_PRO_TSA_URL=https://freetsa.org/tsr

# Sólo si la autoridad publica varias políticas y exige elegir una (OID).
ACTA_PRO_TSA_POLITICA=

# El token se descarga en /api/reuniones/{id}/sello.tsr y se verifica con:
#   openssl ts -verify -in acta.tsr -token_in -digest <huella impresa en el acta> \
#     -CAfile cadena-de-la-autoridad.pem

# ── Almacenamiento de archivos ───────────────────────────────────────────────
# drive : la docente puede abrir la carpeta del estudiante por su cuenta.
# s3    : opaco. Todo acceso pasa por la pantalla de repositorio de la app.

ACTA_PRO_STORAGE=drive

# Solo con ACTA_PRO_STORAGE=s3.
# Para Firebase Storage: los buckets de Firebase son buckets de Google Cloud
# Storage, que expone una API compatible con S3 mediante claves HMAC de
# interoperabilidad. Basta con:
#   S3_ENDPOINT=https://storage.googleapis.com
# Sirve igual para Cloudflare R2 o MinIO.

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Google: Calendar, Drive y Gmail ──────────────────────────────────────────
# Cliente OAuth2 con refresh token de la cuenta institucional. Se usa OAuth2 y
# no una cuenta de servicio porque Gmail tiene que enviar *como* la cuenta del
# centro.
#
# Scopes necesarios al generar el refresh token:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/gmail.send
#
# `drive.file` y no `drive`: da acceso solo a los archivos que crea la propia
# aplicación, no a todo el Drive del centro.
#
# Para obtener el refresh token y comprobar que todo responde:
#   npm --prefix web run google:url
#   npm --prefix web run google:token -- EL_CODIGO
#   npm --prefix web run google:check
#
# Nota al comprobar a mano: `calendar.events` no permite listar los calendarios
# de la cuenta y `gmail.send` no permite leer el buzón. Probar con esos
# endpoints devuelve 403 aunque la configuración sea correcta.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

GOOGLE_CALENDAR_ID=primary

# Las dos carpetas se crean con:  npm --prefix web run google:folders
# (reutiliza las que ya existan, así que puede ejecutarse las veces que haga falta)

# Carpeta raíz del árbol `ACTA PRO/Docentes/...`
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Carpeta SEPARADA para las transcripciones, con sus propios permisos.
# La transcripción nunca se guarda junto al acta: si compartir el acta con la
# familia arrastrase la transcripción, se estaría entregando todo lo que se
# habló, incluidos comentarios sobre otros estudiantes.
GOOGLE_DRIVE_TRANSCRIPT_FOLDER_ID=

# ── Runachay ─────────────────────────────────────────────────────────────────
# Plataforma institucional del centro. Si no responde, la reunión no se pierde:
# se marca para verificación manual.

RUNACHAY_API_URL=
RUNACHAY_API_KEY=
RUNACHAY_STUDENT_ENDPOINT=/students
RUNACHAY_REPRESENTATIVE_ENDPOINT=/representatives
