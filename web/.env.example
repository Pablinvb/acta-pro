# ─────────────────────────────────────────────────────────────────────────────
# ACTA PRO — configuración
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y NUNCA debe subirse al repositorio.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: nada de esto llega al
# navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sesión ───────────────────────────────────────────────────────────────────

# Clave con la que se firma la cookie de sesión. Mínimo 32 caracteres.
# OBLIGATORIA en producción; si falta, el servidor no arranca.
#   openssl rand -base64 32
AUTH_SECRET=

# Contraseña de acceso docente. OBLIGATORIA en producción.
# En desarrollo, si se deja vacía se usa `acta-pro-demo`.
#
# Es una contraseña compartida provisional: todavía no hay almacén de usuarios.
# Cuando lo haya, se sustituye `verifyCredentials` en src/lib/auth.ts.
TEACHER_PASSWORD=

# ── Modo de ejecución ────────────────────────────────────────────────────────

# demo : no se llama a ningún servicio externo. La app funciona entera con los
#        datos de docs/DATOS_DE_PRUEBA.md.
# live : se usan Google, OpenAI y Runachay de verdad.
ACTA_PRO_MODE=demo

# memory   : el estado vive en el proceso y se pierde al reiniciar.
# postgres : persistencia real. Crea la base con db/schema.sql.
ACTA_PRO_PERSISTENCE=memory

# Solo con ACTA_PRO_PERSISTENCE=postgres.
#   psql "$DATABASE_URL" -f web/db/schema.sql
DATABASE_URL=
# Pon `false` solo en desarrollo local sin TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Tiempo máximo para cualquier integración externa, en milisegundos.
EXTERNAL_TIMEOUT_MS=15000

# ── Transcripción ────────────────────────────────────────────────────────────
# deepgram : separa voces. Cada intervención llega con una etiqueta de hablante
#            («A», «B»), y la docente pone los nombres UNA vez por reunión.
# openai   : no separa voces. La docente asigna el hablante de cada frase.

TRANSCRIPTION_PROVIDER=deepgram

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Análisis de la reunión, revisión de lenguaje y depuración de la transcripción.
# OPENAI_TRANSCRIPTION_MODEL solo se usa si TRANSCRIPTION_PROVIDER=openai.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ── Almacenamiento de archivos ───────────────────────────────────────────────
# drive : la docente puede abrir la carpeta del estudiante por su cuenta.
# s3    : opaco. Todo acceso pasa por la pantalla de repositorio de la app.

ACTA_PRO_STORAGE=drive

# Solo con ACTA_PRO_STORAGE=s3.
# Para Firebase Storage: los buckets de Firebase son buckets de Google Cloud
# Storage, que expone una API compatible con S3 mediante claves HMAC de
# interoperabilidad. Basta con:
#   S3_ENDPOINT=https://storage.googleapis.com
# Sirve igual para Cloudflare R2 o MinIO.

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Google: Calendar, Drive y Gmail ──────────────────────────────────────────
# Cliente OAuth2 con refresh token de la cuenta institucional. Se usa OAuth2 y
# no una cuenta de servicio porque Gmail tiene que enviar *como* la cuenta del
# centro.
#
# Scopes necesarios al generar el refresh token:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/gmail.send
#
# `drive.file` y no `drive`: da acceso solo a los archivos que crea la propia
# aplicación, no a todo el Drive del centro.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

GOOGLE_CALENDAR_ID=primary

# Carpeta raíz del árbol `ACTA PRO/Docentes/...`
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Carpeta SEPARADA para las transcripciones, con sus propios permisos.
# La transcripción nunca se guarda junto al acta.
GOOGLE_DRIVE_TRANSCRIPT_FOLDER_ID=

# ── Runachay ─────────────────────────────────────────────────────────────────
# Plataforma institucional del centro. Si no responde, la reunión no se pierde:
# se marca para verificación manual.

RUNACHAY_API_URL=
RUNACHAY_API_KEY=
RUNACHAY_STUDENT_ENDPOINT=/students
RUNACHAY_REPRESENTATIVE_ENDPOINT=/representatives
