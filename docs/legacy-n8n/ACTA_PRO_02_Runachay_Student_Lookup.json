        "jsCode": "const trigger = $('Execute Workflow Trigger').item.json;\nconst student = items[0] && items[0].json && items[0].json.error ? null : (items[0] ? items[0].json : null);\nconst rep = items[0] && items[0].json ? items[0].json.representative || null : null;\nconst ok = !!(student && !student.error);\nreturn [{ json: {\n  meeting_id: trigger.meeting_id,\n  student: student,\n  representative: rep,\n  data_status: ok ? 'ok' : 'manual_verification_required',\n}}];"
